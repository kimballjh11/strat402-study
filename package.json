{
  "name": "strat402-study",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && vite build --mode single && node -e \"require('fs').renameSync('dist-single/index.html','dist-single/strat402.html')\"",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "ingest": "python3 -I scripts/ingest.py && python3 -I scripts/contact.py && python3 -I scripts/parse_quizzes.py && python3 -I scripts/build_map.py && vitest run tests/unit/coverage.test.ts",
    "ingest:401": "python3 -I scripts/strat401/ingest.py && python3 -I scripts/strat401/build_map.py"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
